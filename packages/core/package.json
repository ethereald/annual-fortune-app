{
  "name": "@annual-fortune/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    }
  },
  "dependencies": {
    "iztro": "^2.5.8",
    "lunar-javascript": "^1.7.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run && node --test tools/snippets.test.mjs tools/mine-dataset.test.mjs",
    "snippets:mine": "node tools/mine-dataset.mjs",
    "snippets:build": "node tools/build-snippets.mjs",
    "snippets:export-web": "node tools/export-web-interpretations.mjs",
    "snippets:coverage": "node tools/check-snippet-coverage.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
